// The electric sparks of the camouflage, pre-computed from the original game's textures (tools/make_cloak_sparks.py): 8 cells of
// intensity side by side, tinted by the colour the Lua draws with (cl_cloak_lines.lua)
"UnlitGeneric"
{
	"$basetexture" "grymod/cloak/cloak_sparks"
	"$additive" 1
	"$vertexcolor" 1
	"$vertexalpha" 0
	"$ignorez" 1
	"$nocull" 1
	"$nolod" 1
}
